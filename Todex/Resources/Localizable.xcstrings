    "此前输出无法重放；只会接收连接后的输出。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier output can't be replayed; only output after connecting will be received."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の出力は再生できません。接続後の出力のみ受信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 출력은 다시 재생할 수 없습니다. 연결 이후의 출력만 수신합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前输出无法重放；只会接收连接后的输出。"
