      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parts can be scanned in any order; pairing info is saved only after every part of the same batch is collected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分割コードは任意の順序でスキャンできます。同じバッチをすべて読み取った後にペアリング情報が保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할 코드는 어떤 순서로든 스캔할 수 있으며, 같은 묶음을 모두 모은 후에 페어링 정보가 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分片可按任意顺序扫描；收齐同一批次后才会保存配对信息。"
          }
        }
      }
    },
