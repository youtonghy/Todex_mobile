        }
      }
    },
    "此后端不支持%@，请更新后端后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backend doesn't support %@. Update the backend and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックエンドは%@に対応していません。バックエンドを更新してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백엔드는 %@을(를) 지원하지 않습니다. 백엔드를 업데이트한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后端不支持%@，请更新后端后重试。"
          }
        }
      }
    },
    "此后端未提供参数 Schema，请按工具说明填写 JSON 对象。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backend didn't provide a parameter Schema. Fill in a JSON object according to the tool's description."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックエンドはパラメーター Schema を提供していません。ツールの説明に従って JSON オブジェクトを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백엔드는 매개변수 Schema를 제공하지 않습니다. 도구 설명에 따라 JSON 객체를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此后端未提供参数 Schema，请按工具说明填写 JSON 对象。"
          }
        }
      }
    },
    "此审批已处理、已撤回或内容已更新。请从当前记录打开新的请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This approval has already been handled, withdrawn, or updated. Open the new request from the current history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この承認は処理済み、取り下げ済み、または内容が更新されています。現在の履歴から新しいリクエストを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 승인은 이미 처리되었거나 철회되었거나 내용이 업데이트되었습니다. 현재 기록에서 새 요청을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此审批已处理、已撤回或内容已更新。请从当前记录打开新的请求。"
          }
        }
      }
    },
