    "「%@」不符合请求的字段类型、范围或必填要求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" does not meet the requested field type, range, or required constraint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が要求されたフィールドの型、範囲、または必須条件を満たしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"이(가) 요청한 필드 유형, 범위 또는 필수 조건을 충족하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不符合请求的字段类型、范围或必填要求。"
          }
        }
      }
    },
    "「%@」需要可精确表示的整数（绝对值不超过 9007199254740991）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" needs an exactly representable integer (absolute value no greater than 9007199254740991)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には正確に表現できる整数が必要です（絶対値 9007199254740991 以下）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에는 정확히 표현 가능한 정수가 필요합니다(절댓값 9007199254740991 이하)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要可精确表示的整数（绝对值不超过 9007199254740991）。"
          }
        }
      }
    },
    "「%@」需要有效数字。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" needs a valid number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には有効な数値が必要です。"
