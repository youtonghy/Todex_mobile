        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에는 유효한 숫자가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要有效数字。"
          }
        }
      }
    },
