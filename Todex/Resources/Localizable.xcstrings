{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "\nAgent 当前正忙，请求会进入候选队列，待当前任务结束后发送。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nThe Agent is busy. The request will be added to the candidate queue and sent after the current task finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nエージェントは現在処理中です。リクエストは候補キューに追加され、現在のタスクの終了後に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n에이전트가 현재 작업 중입니다. 요청은 후보 큐에 추가되어 현재 작업이 끝난 후 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAgent 当前正忙，请求会进入候选队列，待当前任务结束后发送。"
          }
        }
      }
    },
    "\n…（差异过大已截断）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… (diff too large, truncated)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n…（差分が大きすぎるため省略されました）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n…(차이가 너무 커서 잘림)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n…（差异过大已截断）"
          }
        }
      }
    },
    "\n可用于：": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCan be used for: "
          }
        },
