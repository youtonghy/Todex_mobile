        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Token はアプリ本体がキーチェーンに保存します。転送暗号化が有効な場合、接続には対応する公開鍵も必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Token은 앱이 키체인에 저장합니다. 전송 암호화가 활성화되어 있으면 연결에 해당 공개 키도 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 由主程序通过 Keychain 保存。传输加密启用时，连接还需要对应的公钥。"
          }
        }
      }
    },
