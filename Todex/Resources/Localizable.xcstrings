        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n错误：%@"
          }
        }
      }
    },
    "\r\n\u001b[2m[TodeX] 终端已退出，正在自动重启…\u001b[0m\r\n": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n\u001b[2m[TodeX] Terminal exited, restarting automatically…\u001b[0m\r\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n\u001b[2m[TodeX] ターミナルが終了しました。自動的に再起動しています…\u001b[0m\r\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n\u001b[2m[TodeX] 터미널이 종료되었습니다. 자동으로 다시 시작하는 중…\u001b[0m\r\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\r\n\u001b[2m[TodeX] 终端已退出，正在自动重启…\u001b[0m\r\n"
          }
        }
      }
    },
