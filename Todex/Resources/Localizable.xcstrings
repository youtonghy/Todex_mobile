        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 파일 미리 보기 · 페이지 스크립트 비활성화됨({ }를 탭해 활성화). 상대 경로 리소스는 로드되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区文件预览 · 页面脚本已禁用（可点按 { } 启用）；相对路径资源不会加载。"
          }
        }
      }
    },
