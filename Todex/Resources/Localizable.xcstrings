      }
    },
    "将从后端删除此对话及历史，无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation and its history will be deleted from the backend. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話と履歴をバックエンドから削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화와 기록이 백엔드에서 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从后端删除此对话及历史，无法撤销。"
          }
        }
      }
    },
    "将升级后端“%@”（%@）上的 CLI。后端有正在运行的 Agent 时会拒绝升级。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upgrades the CLI on backend “%@” (%@). The backend rejects the upgrade while an Agent is running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンド「%@」（%@）の CLI をアップグレードします。実行中のエージェントがある場合、バックエンドはアップグレードを拒否します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 ‘%@’(%@)의 CLI를 업그레이드합니다. 실행 중인 에이전트가 있으면 백엔드가 업그레이드를 거부합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将升级后端“%@”（%@）上的 CLI。后端有正在运行的 Agent 时会拒绝升级。"
          }
        }
      }
    },
    "将原样插入 %@。可在消息输入框补充参数。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be inserted as is. You can add arguments in the message box."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をそのまま挿入します。メッセージ入力欄で引数を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 그대로 삽입합니다. 메시지 입력란에서 인수를 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将原样插入 %@。可在消息输入框补充参数。"
          }
        }
      }
    },
    "将同时从 live 配置中移除该节点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This node will also be removed from the live config."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノードは live 設定からも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 노드는 live 설정에서도 제거됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将同时从 live 配置中移除该节点。"
          }
        }
      }
    },
    "将把已审阅的「%@」请求发送到当前对话。Agent 将按请求执行，可能修改仓库或 PR。%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reviewed “%@” request will be sent to the current conversation. The Agent will act on it and may modify the repository or PR.%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュー済みの「%@」リクエストを現在の会話に送信します。エージェントはリクエストに従って実行し、リポジトリや PR を変更する可能性があります。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토한 ‘%@’ 요청을 현재 대화로 보냅니다. 에이전트가 요청에 따라 실행하며 리포지토리나 PR을 변경할 수 있습니다.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把已审阅的「%@」请求发送到当前对话。Agent 将按请求执行，可能修改仓库或 PR。%@"
          }
        }
      }
    },
    "将提交“%@”。请确认这符合你的意愿。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be submitted. Make sure this is what you want."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を送信します。意図どおりか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 제출합니다. 원하는 내용인지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提交“%@”。请确认这符合你的意愿。"
          }
        }
      }
    },
    "将改写该 Agent 的全局配置文件，对 TodeX 内外的新会话同时生效；运行中的会话不受影响。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rewrites the Agent's global config file and applies to new sessions both inside and outside TodeX; running sessions are not affected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントのグローバル設定ファイルを書き換え、TodeX 内外の新しいセッションに適用されます。実行中のセッションには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에이전트의 전역 설정 파일을 다시 쓰며 TodeX 안팎의 새 세션에 모두 적용됩니다. 실행 중인 세션에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将改写该 Agent 的全局配置文件，对 TodeX 内外的新会话同时生效；运行中的会话不受影响。"
          }
        }
      }
    },
