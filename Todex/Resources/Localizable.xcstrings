        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n可用于："
          }
        }
      }
    },
    "\n已附加到草稿 · 点按移除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAttached to draft · Tap to remove"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n下書きに添付済み · タップで削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n초안에 첨부됨 · 탭하여 제거"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n已附加到草稿 · 点按移除"
          }
        }
      }
    },
