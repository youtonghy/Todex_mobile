    "订阅分页没有前进，恢复未完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription paging didn't advance; recovery incomplete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションのページングが進まず、復元が完了しませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 페이지가 진행되지 않아 복구가 완료되지 않았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅分页没有前进，恢复未完成"
          }
        }
      }
    },
    "订阅分页过多，恢复未完成": {
      "localizations": {
