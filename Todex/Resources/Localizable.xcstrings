    "%@\n\n网络中断可能发生在后端接收之后。核对历史不会再次发送消息。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe network may have dropped after the backend received the message. Reviewing history will not resend it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nネットワークの切断はバックエンドの受信後に発生した可能性があります。履歴を確認してもメッセージは再送されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n네트워크 끊김은 백엔드가 메시지를 수신한 후에 발생했을 수 있습니다. 기록을 확인해도 메시지는 다시 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n网络中断可能发生在后端接收之后。核对历史不会再次发送消息。"
          }
        }
      }
    },
    "%@\n%@ → %@ · head %@\n合并方式：%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n%@ → %@ · head %@\nMerge method: %@ · %@"
