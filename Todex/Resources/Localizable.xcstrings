    "密钥显示为掩码；保持掩码不变即沿用已存密钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is shown masked; leave the mask unchanged to keep the stored key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはマスク表示されています。マスクをそのままにすると保存済みキーが維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 마스킹되어 표시됩니다. 마스킹을 그대로 두면 저장된 키가 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥显示为掩码；保持掩码不变即沿用已存密钥。"
          }
        }
      }
    },
    "密钥由后端脱敏返回；保持掩码值不变即沿用已存密钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend returns the key redacted; leave the masked value unchanged to keep the stored key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはバックエンドでマスクされて返されます。マスク値をそのままにすると保存済みキーが維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 백엔드에서 마스킹되어 반환됩니다. 마스킹된 값을 그대로 두면 저장된 키가 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥由后端脱敏返回；保持掩码值不变即沿用已存密钥。"
          }
        }
      }
    },
