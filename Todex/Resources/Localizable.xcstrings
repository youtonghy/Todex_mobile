        }
      }
    },
    "\n目标仓库：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nTarget repository: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n対象リポジトリ：%@"
          }
        },
        "ko": {
          "stringUnit": {
