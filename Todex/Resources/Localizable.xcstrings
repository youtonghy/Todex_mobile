    "\n请先刷新版本及现有操作，再决定是否重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nRefresh the version and existing actions before deciding whether to retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nバージョンと既存の操作を更新してから、再試行するかどうか判断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n버전과 기존 작업을 새로고침한 후 다시 시도할지 결정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n请先刷新版本及现有操作，再决定是否重试。"
          }
        }
      }
    },
    "\n读取最新版本后可手动合并；不会覆盖远端。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLoad the latest version to merge manually; the remote will not be overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n最新バージョンを読み込んだ後、手動でマージできます。リモートは上書きされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n최신 버전을 불러온 후 수동으로 병합할 수 있습니다. 원격은 덮어쓰지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n读取最新版本后可手动合并；不会覆盖远端。"
          }
        }
      }
    },
    "\n错误：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nError: %@"
          }
        },
        "ja": {
