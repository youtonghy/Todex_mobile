    "当前任务尚未结束": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current task has not finished"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のタスクはまだ終了していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업이 아직 끝나지 않았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务尚未结束"
          }
        }
      }
    },
    "当前任务结束后按顺序发送；后台或断线后暂停。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent in order after the current task finishes; paused in the background or when disconnected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のタスク終了後に順番に送信します。バックグラウンドまたは切断時は一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업이 끝나면 순서대로 전송합니다. 백그라운드 상태이거나 연결이 끊기면 일시 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务结束后按顺序发送；后台或断线后暂停。"
          }
        }
      }
    },
    "当前写操作尚未结束或结果未知，请先核对，避免重复执行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current write action has not finished or its result is unknown. Verify first to avoid running it twice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の書き込み操作がまだ終了していないか、結果が不明です。重複実行を避けるため、先に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 쓰기 작업이 아직 끝나지 않았거나 결과를 알 수 없습니다. 중복 실행을 피하려면 먼저 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前写操作尚未结束或结果未知，请先核对，避免重复执行。"
          }
        }
      }
    },
