    "本地 Codex 会话状态不可用，请停止后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Codex session state is unavailable; stop it and retry"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル Codex セッションの状態が使用できません。停止して再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
