{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@。示例：http://192.168.1.10:7345": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Example: http://192.168.1.10:7345"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。例：http://192.168.1.10:7345"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예: http://192.168.1.10:7345"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。示例：http://192.168.1.10:7345"
          }
        }
      }
    },
    "%@。请在设置中核对“传输加密”与“加密公钥”，或重新导入后端配对信息。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Check \"Transport encryption\" and \"Encryption public key\" in Settings, or re-import the backend pairing info."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。設定で「転送暗号化」と「暗号化公開鍵」を確認するか、バックエンドのペアリング情報を再インポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 설정에서 \"전송 암호화\"와 \"암호화 공개 키\"를 확인하거나 백엔드 페어링 정보를 다시 가져오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。请在设置中核对“传输加密”与“加密公钥”，或重新导入后端配对信息。"
          }
        }
      }
    },
    "/v1 协议已移除，请使用后端根地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The /v1 protocol has been removed; use the backend root address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 プロトコルは削除されました。バックエンドのルートアドレスを使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 프로토콜이 제거되었습니다. 백엔드 루트 주소를 사용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 协议已移除，请使用后端根地址"
          }
        }
      }
    },
    "Agent 未接受新的模型或思考深度配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent did not accept the new model or reasoning effort settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが新しいモデルまたは思考強度の設定を受け入れませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 새 모델 또는 사고 강도 설정을 수락하지 않았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 未接受新的模型或思考深度配置"
          }
        }
      }
    },
    "Backend 地址无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid backend address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドのアドレスが無効です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 주소가 잘못되었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 地址无效"
          }
        }
      }
    },
    "Backend 未启动或地址不可达": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend is not running or the address is unreachable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが起動していないか、アドレスに到達できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 실행 중이 아니거나 주소에 연결할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 未启动或地址不可达"
          }
        }
      }
    },
    "Backend 未启动或端口错误（连接被拒绝）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend is not running or the port is wrong (connection refused)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが起動していないか、ポートが間違っています（接続拒否）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 실행 중이 아니거나 포트가 잘못되었습니다(연결 거부됨)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 未启动或端口错误（连接被拒绝）"
          }
        }
      }
    },
    "Codex 响应缺少 result": {
      "localizations": {
