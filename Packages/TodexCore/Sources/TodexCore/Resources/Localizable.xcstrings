          }
        }
      }
    },
    "设备验证结果与后端的传输加密公钥不一致，请重新配对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification result does not match the backend's transport key. Pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証結果がバックエンドの転送暗号化公開鍵と一致しません。再ペアリングしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 결과가 백엔드의 전송 암호화 공개 키와 일치하지 않습니다. 다시 페어링하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
