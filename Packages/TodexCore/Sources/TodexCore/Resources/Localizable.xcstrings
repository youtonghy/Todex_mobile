      }
    },
    "该地址被 App Transport Security 拦截。请使用局域网地址或改用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address was blocked by App Transport Security. Use a local network address or switch to HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは App Transport Security によりブロックされました。LAN アドレスを使用するか、HTTPS に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 App Transport Security에 의해 차단되었습니다. LAN 주소를 사용하거나 HTTPS로 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址被 App Transport Security 拦截。请使用局域网地址或改用 HTTPS。"
          }
        }
      }
    },
