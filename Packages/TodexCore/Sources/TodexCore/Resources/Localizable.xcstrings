      }
    },
    "后端响应无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid backend response"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドの応答が無効です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 응답이 유효하지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端响应无效"
          }
        }
      }
    },
    "后端响应无效。请确认地址指向 TodeX 后端，且中间代理支持 WebSocket。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid backend response. Make sure the address points to a TodeX backend and any proxy in between supports WebSocket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドの応答が無効です。アドレスが TodeX バックエンドを指しており、中継プロキシが WebSocket に対応していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 응답이 유효하지 않습니다. 주소가 TodeX 백엔드를 가리키는지, 중간 프록시가 WebSocket을 지원하는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端响应无效。请确认地址指向 TodeX 后端，且中间代理支持 WebSocket。"
          }
        }
      }
    },
    "后端响应过大": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend response is too large"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドの応答が大きすぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 응답이 너무 큽니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端响应过大"
          }
        }
      }
    },
    "后端在规定时间内没有响应。请确认设备与后端在同一网络，且防火墙放行该端口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend did not respond in time. Make sure the device and backend are on the same network and the firewall allows the port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが時間内に応答しませんでした。デバイスとバックエンドが同じネットワーク上にあり、ファイアウォールでポートが許可されていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 제한 시간 내에 응답하지 않았습니다. 기기와 백엔드가 같은 네트워크에 있고 방화벽에서 해당 포트를 허용하는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端在规定时间内没有响应。请确认设备与后端在同一网络，且防火墙放行该端口。"
          }
        }
      }
    },
    "后端地址无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid backend address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドのアドレスが無効です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 주소가 유효하지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端地址无效"
          }
        }
      }
    },
    "后端所在电脑的磁盘可用空间不足 1 GiB，暂时无法发送新消息。请清理磁盘后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend computer has less than 1 GiB of free disk space, so new messages cannot be sent. Free up disk space and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドのコンピュータの空き容量が 1 GiB 未満のため、新しいメッセージを送信できません。ディスクを整理してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 컴퓨터의 디스크 여유 공간이 1GiB 미만이라 새 메시지를 보낼 수 없습니다. 디스크를 정리한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端所在电脑的磁盘可用空间不足 1 GiB，暂时无法发送新消息。请清理磁盘后重试。"
          }
        }
      }
    },
    "后端拒绝了加密连接，请重新配对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend rejected the encrypted connection. Pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが暗号化接続を拒否しました。再ペアリングしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 암호화 연결을 거부했습니다. 다시 페어링하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端拒绝了加密连接，请重新配对"
          }
        }
      }
