          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 인증 신청이 유효하지 않거나 만료되었습니다. 다시 신청하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
