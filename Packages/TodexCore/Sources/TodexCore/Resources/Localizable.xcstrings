      }
    },
    "这是旧版未加密的历史，只能查看、导出、归档或删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is legacy unencrypted history. You can only view, export, archive, or delete it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは暗号化されていない旧形式の履歴です。表示、書き出し、アーカイブ、削除のみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않은 이전 형식의 기록입니다. 보기, 내보내기, 보관, 삭제만 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是旧版未加密的历史，只能查看、导出、归档或删除"
          }
        }
      }
    },
    "远程后端必须使用加密连接，请重新配对": {
