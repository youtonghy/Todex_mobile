          }
        }
      }
    },
    "请将后端地址改为根地址（不要包含 /v1）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the backend address to the root URL (without /v1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
