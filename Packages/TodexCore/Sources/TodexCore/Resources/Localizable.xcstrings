{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@。示例：http://192.168.1.10:7345": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Example: http://192.168.1.10:7345"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。例：http://192.168.1.10:7345"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 예: http://192.168.1.10:7345"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。示例：http://192.168.1.10:7345"
          }
        }
      }
    },
    "%@。请在“配对与设备验证”中重新配对，并在后端核对随机码与公钥指纹。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Re-pair in “Pairing & Device Verification” and check the code and key fingerprint on the backend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。「ペアリングとデバイス認証」で再ペアリングし、バックエンドで確認コードと公開鍵フィンガープリントを照合してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. “페어링 및 기기 인증”에서 다시 페어링하고 백엔드에서 확인 코드와 공개 키 지문을 대조하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。请在“配对与设备验证”中重新配对，并在后端核对随机码与公钥指纹。"
          }
        }
      }
    },
    "/v1 协议已移除，请使用后端根地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The /v1 protocol has been removed; use the backend root address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 プロトコルは削除されました。バックエンドのルートアドレスを使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 프로토콜이 제거되었습니다. 백엔드 루트 주소를 사용하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1 协议已移除，请使用后端根地址"
          }
        }
      }
    },
    "Agent 未接受新的模型或思考深度配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Agent did not accept the new model or reasoning effort settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが新しいモデルまたは思考強度の設定を受け入れませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 새 모델 또는 사고 강도 설정을 수락하지 않았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 未接受新的模型或思考深度配置"
          }
        }
      }
    },
    "Backend 地址无效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid backend address"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドのアドレスが無効です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드 주소가 잘못되었습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 地址无效"
          }
        }
      }
    },
    "Backend 未启动或地址不可达": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend is not running or the address is unreachable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが起動していないか、アドレスに到達できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 실행 중이 아니거나 주소에 연결할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 未启动或地址不可达"
          }
        }
      }
    },
    "Backend 未启动或端口错误（连接被拒绝）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backend is not running or the port is wrong (connection refused)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドが起動していないか、ポートが間違っています（接続拒否）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 실행 중이 아니거나 포트가 잘못되었습니다(연결 거부됨)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend 未启动或端口错误（连接被拒绝）"
          }
        }
      }
    },
