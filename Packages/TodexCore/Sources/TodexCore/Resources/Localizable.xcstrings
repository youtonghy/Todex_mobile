    },
    "该地址被 App Transport Security 拦截。请使用局域网地址或改用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address was blocked by App Transport Security. Use a local network address or switch to HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは App Transport Security によりブロックされました。LAN アドレスを使用するか、HTTPS に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 App Transport Security에 의해 차단되었습니다. LAN 주소를 사용하거나 HTTPS로 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址被 App Transport Security 拦截。请使用局域网地址或改用 HTTPS。"
          }
        }
      }
    },
    "请填写 http:// 或 https:// 开头的后端根地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a backend root URL starting with http:// or https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// または https:// で始まるバックエンドのルートアドレスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// 또는 https://로 시작하는 백엔드 루트 주소를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写 http:// 或 https:// 开头的后端根地址。"
          }
        }
      }
    },
    "请填写后端根地址，不包含接口路径": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the backend root URL without an API path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API パスを含めずにバックエンドのルートアドレスを入力してください"
