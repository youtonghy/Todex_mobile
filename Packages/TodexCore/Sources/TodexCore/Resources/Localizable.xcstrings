    "后端历史加密响应无效，请检查后端版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid history encryption response from the backend. Check the backend version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンドの履歴暗号化応答が無効です。バックエンドのバージョンを確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드의 기록 암호화 응답이 올바르지 않습니다. 백엔드 버전을 확인하세요"
          }
        },
