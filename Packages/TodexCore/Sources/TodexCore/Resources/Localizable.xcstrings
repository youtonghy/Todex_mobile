          }
        }
      }
    },
    "请检查后端地址与网络后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the backend address and network, then try again."
          }
        },
        "ja": {
          "stringUnit": {
